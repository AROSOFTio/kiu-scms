# ======================================================== #
#        SCMS PRODUCTION DEPLOYMENT ENVIRONMENT FILE       #
# ======================================================== #
# Instructions:
# 1. Copy this file to `.env` in the project root
# 2. Fill in the real values below
# 3. Run: bash scripts/fix-mysql-docker.sh  (once, as root)
# 4. Run: bash scripts/deploy.sh

# ----------------- DATABASE CONFIGURATION -----------------
# DB_HOST must be host.docker.internal so Docker containers can
# reach aaPanel MySQL on the host.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=kiu_scms
DB_USER=kiu_scms
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_CONNECT_TIMEOUT=30000

# ------------------ BACKEND CONFIGURATION -----------------
JWT_SECRET=YOUR_SUPER_SECRET_PRODUCTION_KEY_MIN_32_CHARS_HERE
NODE_ENV=production

# ----------------- FRONTEND CONFIGURATION -----------------
# aaPanel or host Nginx should reverse proxy to this port.
FRONTEND_PORT=3001
# Keep /api/v1 when the public domain proxies to the frontend container.
VITE_API_URL=/api/v1
APP_URL=https://kiuscms.arosoft.io

# Verification:
# curl http://127.0.0.1:3001/health

# ----------------- OPTIONAL: EMAIL NOTIFICATIONS ----------
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASS=
